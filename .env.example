# No quotes or trailing comma on the line
GROQ_API_KEY=gsk_your_key_here
ATLASSIAN_SITE_URL=https://structuredweb.atlassian.net/

# Optional: align JQL with your dashboard gadgets (copy from Jira filter on the gadget)
JIRA_DASHBOARD_NAME=R&D team - Customer reported Open Issues
JIRA_DASHBOARD_URL=https://structuredweb.atlassian.net/jira/dashboards/10120
JIRA_OPEN_ISSUES_JQL=priority in ("P0- Highest", "P1", "P1 - High") AND statusCategory != Done ORDER BY priority ASC, updated DESC
